# Copy to .env for local development. Do not put production secrets in this file.

DATABASE_URL=postgresql://domyn:change-me@localhost:5432/domyn
APP_BASE_URL=http://localhost:3000

# Used only by prisma/seed.ts outside production.
SEED_DEMO_PASSWORD=replace-me-for-local-seed-only

# IANA timezone used to display operational times. Storage remains UTC.
# Asia/Jakarta is a provisional operations default pending TLT confirmation.
APP_TIMEZONE=Asia/Jakarta

# sandbox | whatsapp
# sandbox records delivery attempts and does not contact WhatsApp.
WHATSAPP_PROVIDER=sandbox
# WHATSAPP_API_URL=
# WHATSAPP_TOKEN=
# WHATSAPP_SENDER=
# WHATSAPP_TEMPLATE_NAME=

# Protects the SLA job endpoint. Send as: Authorization: Bearer <value>
CRON_SECRET=replace-with-a-long-random-string

# Local development only. Production never returns password-reset links.
EXPOSE_RESET_TOKEN=true
